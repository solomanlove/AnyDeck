<?xml version="1.0" encoding="utf-8"?>
<!-- 仅使用情况访问权限；没有网络、后台服务、开机启动或隐藏入口。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.adbmanage.companion" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <application android:label="@string/app_name" android:allowBackup="false"
        android:supportsRtl="true" android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".UsageProvider" android:authorities="com.adbmanage.companion.usage"
            android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
